{
  "private": true,
  "workspaces": [
    "packages/vscode-ws-jsonrpc",
    "packages/socketio",
    "packages/client",
    "packages/wrapper-react",
    "packages/examples"
  ],
  "type": "module",
  "scripts": {
    "clean": "npm run clean --workspaces",
    "compile": "npm run compile --workspaces",
    "watch:clean": "tsc --build tsconfig.build.json --clean",
    "watch": "tsc --build tsconfig.build.json --watch --verbose",
    "lint": "oxlint --type-aware",
    "lint:notypese": "oxlint",
    "production:build": "npm run production:build --workspace packages/examples",
    "production:preview:build": "npm run production:preview:build --workspace packages/examples",
    "production:preview": "npm run production:preview --workspace packages/examples",
    "dev": "vite",
    "dev:debug": "vite --debug --force",
    "report:versions:vite": "echo vite: && vite --version && echo vitest: && vitest --version",
    "report:versions:node": "echo npm: && npm --version && echo node: && node --version",
    "report:versions:tools": "echo tsc: && tsc --version",
    "report:versions": "echo Reporting versions: && npm run report:versions:node && npm run report:versions:vite && npm run report:versions:tools",
    "build": "npm run build --workspaces",
    "build:client": "npm run build --workspace packages/client",
    "build:vscode-ws-jsonrpc": "npm run build --workspace packages/vscode-ws-jsonrpc",
    "build:wrapper": "npm run build --workspace packages/wrapper",
    "build:wrapper-react": "npm run build --workspace packages/wrapper-react",
    "build:examples": "npm run build --workspace packages/examples",
    "langium:generate": "npm run langium:generate --workspace packages/examples",
    "start:example:server:groovy": "npm run start:server:groovy --workspace packages/examples",
    "start:example:server:jdtls": "npm run start:server:jdtls --workspace packages/examples",
    "start:example:server:json": "npm run start:server:json --workspace packages/examples",
    "start:example:server:python": "npm run start:server:python --workspace packages/examples",
    "release:prepare": "npm run reset:repo && npm ci && npm run build && npm run lint && npm run fmt && npm run test:ci",
    "reset:chrome": "shx rm -fr ./.chrome",
    "reset:repo": "git clean -f -d -x --exclude=.chrome",
    "test": "vitest --config vitest.config.ts run",
    "test:watch": "vitest --config vitest.config.ts",
    "test:tags:worker": "vitest --config vitest.config.ts --tags-filter=worker run",
    "test:tags:main": "vitest --config vitest.config.ts --tags-filter=main run",
    "test:tags": "npm run test:tags:main && npm run test:tags:worker",
    "test:ci": "npm run test:install && concurrently \"npm run test:server:commander\" \"npm run test\"",
    "test:ci:tags": "npm run test:install && concurrently \"npm run test:server:commander\" \"npm run test:tags\"",
    "test:coverage": "vitest --config vitest.config.ts run --coverage",
    "test:install": "playwright install chromium",
    "test:server:commander": "npm run test:server:commander --workspace packages/socketio",
    "license:check": "docker compose -f ./scripts/addlicense/docker-compose.yml run --rm addlicense-check",
    "license:add": "docker compose -f ./scripts/addlicense/docker-compose.yml run --rm addlicense-add",
    "license:help": "docker compose -f ./scripts/addlicense/docker-compose.yml run --rm addlicense-help",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "knip": "knip",
    "init:examples": "npm run init --workspace packages/examples"
  },
  "devDependencies": {
    "@codingame/monaco-vscode-rollup-vsix-plugin": "^36.2.7",
    "@testing-library/react": "~16.3.3",
    "@types/node": "~24.10.15",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.5",
    "@vitest/browser": "~4.1.11",
    "@vitest/browser-playwright": "~4.1.11",
    "@vitest/coverage-v8": "~4.1.11",
    "concurrently": "~10.0.5",
    "knip": "~6.34.0",
    "minimatch": "~10.2.6",
    "oxfmt": "~0.66.0",
    "oxlint": "~1.81.0",
    "oxlint-tsgolint": "~7.0.2001",
    "shx": "~0.4.0",
    "tsx": "~4.23.13",
    "typescript": "~7.0.2",
    "vite": "~8.2.2",
    "vitest": "~4.1.11"
  },
  "overrides": {
    "dompurify": "~3.4.14"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "allowScripts": {
    "esbuild": false
  }
}
